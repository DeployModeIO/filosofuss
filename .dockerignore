# Contexto de build (imagen web). Excluye dependencias y artefactos locales,
# pero conserva `public/` y `src/` (necesarios para el build de Vite).
node_modules
dist
dist-ssr

# Android / Capacitor nativo (la imagen es solo la web).
android

# VCS y tooling local.
.git
.gitignore
.serena
docs
.vscode
.idea
.DS_Store

# Secretos y variables de entorno (nunca en la imagen).
.env
.env.*
*.local

# Logs y artefactos de ejecución.
*.log
logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
scripts/.translate-progress.json

# Auxiliares no necesarios para el build.
